APP_NAME=AccessTracker
API_V1_PREFIX=/api/v1

# MongoDB
MONGO_URI=mongodb://localhost:27017
MONGO_DB_NAME=access_tracker

# Redis
REDIS_URL=redis://localhost:6379/0

# Resend
# Use a sending domain verified in Resend.
RESEND_API_KEY=re_replace_with_your_resend_api_key
RESEND_FROM_EMAIL=AccessTracker <noreply@your-verified-domain.com>

# JWT
JWT_SECRET_KEY=replace_with_a_long_random_secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXP_MINUTES=30
REFRESH_TOKEN_EXP_DAYS=7
REFRESH_TOKEN_PEPPER=replace_with_a_long_random_secret

# Password hashing
PASSWORD_HASH_TIME_COST=2
PASSWORD_HASH_MEMORY_COST=102400
PASSWORD_HASH_PARALLELISM=8

# Email OTP and password recovery
OTP_PEPPER=replace_with_a_long_random_secret
OTP_EXPIRE_SECONDS=600
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_MAX_ATTEMPTS=5
PASSWORD_RESET_TOKEN_EXPIRE_SECONDS=600
